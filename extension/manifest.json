{
  "manifest_version": 3,
  "name": "CoursePilot — Video Auto-Advance & Quiz Pause",
  "version": "1.0.0",
  "description": "Automate repetitive video playback and auto-advance on LinkedIn Learning and Coursera with floating quiz safety pause.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.coursera.org/*",
    "*://*.lntedutech.com/*",
    "https://api.github.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CoursePilot Controls",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.coursera.org/*",
        "*://*.lntedutech.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

