{
  "name": "coursepilot",
  "version": "1.0.0",
  "description": "Automate the repetition. Keep control of the learning.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"tsx watch src/main.ts\" \"vite\"",
    "dev:server": "tsx watch src/main.ts",
    "dev:ui": "vite",
    "build": "vite build && tsc",
    "package:extension": "node scripts/generate-pngs.js && cd extension && zip -FS -r ../coursepilot-extension.zip ./* && cd ..",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/madankalyan2211/CoursePilot.git"
  },
  "homepage": "https://github.com/madankalyan2211/CoursePilot#readme",
  "bugs": {
    "url": "https://github.com/madankalyan2211/CoursePilot/issues"
  },
  "keywords": [
    "linkedin-learning",
    "coursera",
    "automation",
    "chrome-extension",
    "playwright",
    "coursepilot"
  ],

  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.395.0",
    "playwright": "^1.44.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.13",
    "vitest": "^1.6.0"
  }
}
